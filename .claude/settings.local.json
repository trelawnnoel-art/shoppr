{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(echo \"started with PID $!\")",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000 --max-time 5)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3006 --max-time 5)",
      "Bash(taskkill //F //PID 201)",
      "Bash(pkill -f \"next dev\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3006 --max-time 3)",
      "PowerShell(Get-NetTCPConnection -LocalPort 3006 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object { Stop-Process -Id $_ -Force; \"Killed PID $_\" })",
      "Bash(npx tsc *)",
      "Bash(curl -s http://localhost:3006 -o /tmp/shoppr-page.html -w \"%{http_code}\\\\n\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3007 --max-time 5)"
    ]
  }
}
