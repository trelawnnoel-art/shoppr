# Copy this file to .env and fill in real values — .env itself is
# gitignored and never committed.

DATABASE_URL="file:./dev.db"

# Signs session cookies (lib/session.ts). Generate a real random value for
# anything beyond local dev — e.g. `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-random-secret"

# Required for /api/ai-search (Claude). Get one at console.anthropic.com —
# see README for setup details. Without this, AI search returns a clean
# 503 instead of crashing.
ANTHROPIC_API_KEY=""

# Optional — powers the "Realistic" avatar style (components/avatar/
# RealisticAvatarScene.tsx) via Avaturn. Get a subdomain at
# developer.avaturn.me. Without this, that style shows an honest
# "not connected yet" placeholder instead of erroring.
NEXT_PUBLIC_AVATURN_SUBDOMAIN=""
